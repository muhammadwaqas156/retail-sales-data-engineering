# Copy to ~/.dbt/profiles.yml (outside the repo). Never commit real credentials.
retail_analytics:
  target: dev
  outputs:
    dev:
      type: snowflake
      account: "{{ env_var('SNOWFLAKE_ACCOUNT') }}"
      user: "{{ env_var('SNOWFLAKE_USER') }}"
      password: "{{ env_var('SNOWFLAKE_PASSWORD') }}"
      role: RETAIL_ROLE
      database: RETAIL_DB
      warehouse: RETAIL_WH
      schema: SILVER
      threads: 4
